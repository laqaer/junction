---
/** The GitHub mark (simple-icons, CC0), mono, decorative: the link text names it. */
import { GITHUB_MARK_PATH } from "../lib/github-mark";
interface Props { size?: number; class?: string }
const { size = 18, class: cls = "" } = Astro.props;
---
<svg class={`gh-mark ${cls}`} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false"><path fill="currentColor" d={GITHUB_MARK_PATH}></path></svg>
<style>
  .gh-mark { display: inline-block; flex: none; }
</style>
