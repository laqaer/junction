---
/**
 * Primary = --surface on --seal in paper, --bg on --lamp in night (tokens do
 * that switch). A `disabledLabel` renders the named coming-soon state instead
 * of an empty href: never `href=""`, never `#`.
 */
interface Props {
  href?: string;
  variant?: "primary" | "outline" | "quiet";
  disabledLabel?: string;
  type?: "button" | "submit";
  class?: string;
  id?: string;
  external?: boolean;
  track?: string;
  ariaLabel?: string;
}
const { href = "", variant = "primary", disabledLabel, type = "button", class: cls = "", id, external = false, track, ariaLabel } = Astro.props;
const classes = `btn btn-${variant} ${cls}`;
---
{href && href !== "#" ? (
  <a class={classes} href={href} id={id} data-track={track} aria-label={ariaLabel} rel={external ? "noopener" : undefined} target={external ? "_blank" : undefined}><slot /></a>
) : disabledLabel ? (
  <span class={classes} id={id} aria-disabled="true" role="link">{disabledLabel}</span>
) : (
  <button class={classes} type={type} id={id} data-track={track} aria-label={ariaLabel}><slot /></button>
)}
