---
/**
 * The Ward Seal (brand-book §6), verbatim from brand/assets/ward-seal.svg.
 * `--bg` must be the surface the mark sits on so the knocked-out bar segments
 * read as cutting through the shaft. Decorative by default; pass `label` to
 * make it an image with a name.
 */
interface Props {
  size?: number;
  label?: string;
  class?: string;
  /** Mono variant: everything in --fg, bars knocked out only. */
  mono?: boolean;
}
const { size = 24, label, class: cls = "", mono = false } = Astro.props;
const ink = "var(--fg, currentColor)";
const seal = mono ? ink : "var(--seal, #B3301A)";
---
<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={`ward-seal ${cls}`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <circle cx="32" cy="32" r="28" fill="none" stroke={ink} stroke-width="2.5"></circle>
  {size >= 24 && <circle cx="32" cy="32" r="24" fill="none" stroke={ink} stroke-width="0.75"></circle>}
  <circle cx="32" cy="25" r="6" fill={ink}></circle>
  <rect x="29" y="28" width="6" height="18" fill={ink}></rect>
  <rect x="25" y="33" width="14" height="2.5" fill={seal}></rect>
  <rect x="25" y="37.5" width="14" height="2.5" fill={seal}></rect>
  <rect x="25" y="42" width="14" height="2.5" fill={seal}></rect>
  <rect x="29" y="33" width="6" height="2.5" fill="var(--bg, #F3EEE3)"></rect>
  <rect x="29" y="37.5" width="6" height="2.5" fill="var(--bg, #F3EEE3)"></rect>
  <rect x="29" y="42" width="6" height="2.5" fill="var(--bg, #F3EEE3)"></rect>
  {!mono && <rect x="44" y="18" width="3" height="3" fill={seal}></rect>}
</svg>
<style>
  .ward-seal { display: inline-block; vertical-align: middle; flex: none; }
</style>
