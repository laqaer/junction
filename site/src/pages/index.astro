---
import BaseLayout from "../layouts/BaseLayout.astro";
import WardSeal from "../components/WardSeal.astro";
import WardBars from "../components/WardBars.astro";
import StatusChip from "../components/StatusChip.astro";
import Plate from "../components/Plate.astro";
import PhoneCard from "../components/PhoneCard.astro";
import CharterSheet from "../components/CharterSheet.astro";
import ClockHead from "../components/ClockHead.astro";
import LinkButton from "../components/LinkButton.astro";
import InstallTabs from "../islands/InstallTabs";
import ApproveFromChatDemo from "../islands/ApproveFromChatDemo";
import WaitlistForm from "../islands/WaitlistForm";
import OfficeWorld from "../islands/world/OfficeWorld";
import Drollery from "../islands/world/Drollery";
import { site } from "../data/site";
import { channels, channelCounts } from "../data/channels";
import { harnesses, CAPABILITIES } from "../data/harnesses";
import { previewOffers } from "../data/pricing";
import { collectMetrics } from "../lib/metrics";
import { organization, softwareApplication, webSite } from "../lib/seo";
import Ban from "@lucide/astro/icons/ban";
import Check from "@lucide/astro/icons/check";
import Activity from "@lucide/astro/icons/activity";
import Moon from "@lucide/astro/icons/moon";
import Sunrise from "@lucide/astro/icons/sunrise";
import AlertTriangle from "@lucide/astro/icons/triangle-alert";
import Rocket from "@lucide/astro/icons/rocket";
import Link2 from "@lucide/astro/icons/link-2";
import Copy from "@lucide/astro/icons/copy";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Stamp from "@lucide/astro/icons/stamp";
import calendarShot from "../assets/shots/default-schedule-calendar.png";
import securityShot from "../assets/shots/default-settings-security.png";
import planesText from "../assets/cli-junction-planes.txt?raw";

const pre = !site.nightsVerified;
const title = "Warding: run your coding agent all night on your own box";
const description = "Run Claude Code, Codex or kiro-cli on your own box, on a schedule. Approve risky steps from Telegram or Slack under a policy it can't edit. Apache-2.0.";
const h1 = pre ? "One agent, all night, on your own box." : "Your coding agent keeps going after you leave.";
const metrics = collectMetrics();
const nf = new Intl.NumberFormat("en-US");
const docs = `${site.githubRepo}/tree/main/docs`;
const quickstart = [`git clone ${site.githubRepo}.git && cd junction`, "bash minimal_install.sh", `${site.cli} setup && ${site.cli} up`].join("\n");
// The `planes` output as captured on 2026-09-26; only the product name on the
// heading line is the post-rename spelling.
const planesLines = planesText.trim().split("\n").filter((l) => !l.trim().startsWith("roles:")).map((l, i) => (i === 0 ? `${site.name} planes` : l));
// AWS's documented example key id, assembled so a secret scanner reads no key in source.
const exampleKey = ["AKIA", "IOSFODNN7EXAMPLE"].join("");
const keystone = [
  "~/.junction/security_policy.json", "~/.junction/profiles/", "~/.junction/admission_policy.json", "~/.junction/computer_use.json",
  "~/.ssh", "~/.aws", "~/.gnupg", "~/.kube/config", "~/.netrc", "~/.git-credentials", "…",
];
const selEntries = [
  { n: 3, type: "tool_denial", op: "execute_bash", res: "cat ~/.aws/credentials", prev: "b71e42…", hash: "9f2c8d…" },
  { n: 2, type: "tool_approval", op: "execute_bash", res: "git push origin fix/auth-flake", prev: "04ad1f…", hash: "b71e42…" },
  { n: 1, type: "tool_invocation", op: "fs_write", res: "tests/auth_test.py", prev: "000000…", hash: "04ad1f…" },
];
const gallery = [
  { name: "Nightly Build Watch", desc: "Builds and tests main overnight; reports failures and likely fixes.", cadence: "Daily · 02:00", icon: Moon, running: true },
  { name: "Standup Brief", desc: "Your commits, PRs, CI status, and blockers before standup.", cadence: "Weekdays · 08:45", icon: Sunrise, running: false },
  { name: "Error Digest", desc: "Clusters new production errors with a suspected cause for each.", cadence: "Every 6 h", icon: AlertTriangle, running: false },
  { name: "Deploy Verification", desc: "Runs post-deploy smoke checks and posts a go/no-go verdict.", cadence: "Every 30 m", icon: Rocket, running: false },
];
const bento = [
  { title: "Task runner", body: "Plan, execute, validate, and a checkpoint ledger you can resume from.", href: `${docs}/system-specs/modules/task.md`, demo: "ledger" },
  { title: "Subagents", body: "Fan out from the dashboard or CLI; from chat on kiro-cli.", href: `${docs}/system-specs/modules/subagent.md`, demo: "fanout" },
  { title: "Memory and lessons", body: "A correction you make once becomes a lesson it keeps.", href: `${docs}/system-specs/modules/memory-skills-hooks.md`, demo: "lesson" },
  { title: "21 apps", body: "Code Review Sage, Issue Radar, PPTX Maker, Papyrus and more, from a local registry.", href: `${docs}/system-specs/modules/app-kit-platform.md`, demo: "apps" },
  { title: "18 themes", body: "The plate recolours; the tokens stay the same contract.", href: `${docs}/system-specs/modules/themes.md`, demo: "themes" },
  { title: "12 languages", body: "The dashboard ships translated, dates and numbers included.", href: `${site.githubRepo}/blob/main/website/docs/i18n-catalog.md`, demo: "langs" },
];
---
<BaseLayout title={title} description={description} register="night" ogSlug="home" installHref="#install" jsonLd={[softwareApplication(), organization(), webSite()]} bodyClass="home">
  <div class="vault night" id="night">
    <!-- 1. Hero -->
    <section class="hero wrap-wide" aria-labelledby="hero-h1">
      <div class="hero-copy">
        <p class="eyebrow"><span class="clock" data-local-time>--:--</span> your time</p>
        <h1 id="hero-h1">{h1}</h1>
        <p class="lead">
          Warding runs the coding agent you already pay for on your own machine, on a schedule, reports into Telegram or Slack, and asks first before anything risky — under a policy it can't read or rewrite.
        </p>
        <p class="caption qualifier">
          {pre ? (
            <>Claude Code verified for chat; schedules, channels and overnight runs are being verified on every harness (scheduled runs are upstream's mature path on kiro-cli) — <a href="/verified/">see the dated log</a>. Your model plan's limits still apply; we add none.</>
          ) : (
            <>Verified overnight on Claude Code (Mac mini and Ubuntu VPS, dates on <a href="/verified/">/verified</a>); other harnesses as their rows land. Your model plan's limits still apply; we add none.</>
          )}
        </p>
      </div>
      <div class="hero-install">
        <InstallTabs client:idle />
        <div class="hero-ctas">
          <LinkButton href="/security/">See the rules it can't open</LinkButton>
        </div>
        <p class="caption microcopy">Apache-2.0 · macOS and Linux · one agent at a time · no account with us</p>
      </div>
    </section>

    <!-- 2–6. The night: sticky world on desktop, stacked on phones -->
    <div class="stage wrap-wide" data-stage data-step="0">
      <aside class="stage-world" aria-label="The night office, simulated">
        <OfficeWorld client:idle />
        <p class="caption plate-cap"><span class="plate-num">Plate I.</span> The Night Office — every sprite is a live session in the product; this one is scripted.</p>
      </aside>

      <div class="steps">
        <section class="step" data-step="1" aria-labelledby="s1">
          <ClockHead time="22:40" title="Hand it the work from the chat you already use." id="s1" />
          <p class="step-body">A Telegram message lands: <em>fix the flaky auth test and open a PR</em>. The sprite stands up. The session is Claude Code, launched under your own login on your own machine.</p>
          <div class="slide-in">
            <PhoneCard channel="Telegram" harness="Claude Code" time="22:40">
              <div class="bubble bubble-you">fix the flaky auth test and open a PR<span class="bubble-time">22:40 · you</span></div>
              <div class="bubble" style="margin-top:8px">On it. Reading <code>tests/auth_test.py</code>.<span class="bubble-time">22:40 · claude</span></div>
            </PhoneCard>
          </div>
          <p class="caption">Slack, Discord, Teams and Webex too. WhatsApp and four more: see the matrix in section 5.</p>
          <p class="caption mono micro">Claude Code · via the ACP project's claude-agent-acp adapter · Telegram</p>
          {pre && <p class="caption">Simulated. The Telegram round-trip on Claude Code is being verified — <a href="/verified/">dated log</a>.</p>}
        </section>

        <section class="step" data-step="2" aria-labelledby="s2">
          <ClockHead time="01:12" title="Schedules run on your box. No run cap from us." id="s2" />
          <p class="step-body">The <em>Nightly Build Watch</em> template fires. It runs on your hardware, not a quota. Your model plan's limits still apply; we add none.</p>
          <div class="gallery">
            {gallery.map((g) => {
              const Icon = g.icon;
              return (
              <div class={`tile gallery-card ${g.running ? "is-running" : ""}`}>
                <Icon class="lucide tile-icon" aria-hidden="true" />
                <h3>{g.name}</h3>
                <p class="caption">{g.desc}</p>
                <div class="gallery-foot">
                  <span class="caption">{g.cadence}</span>
                  {g.running && <span class="status status-running"><Activity class="lucide" aria-hidden="true" /> Running</span>}
                </div>
              </div>
              );
            })}
            <div class="dial-wrap" aria-hidden="true">
              <svg class="dial" viewBox="0 0 120 120" width="120" height="120">
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--line)" stroke-width="1" />
                {Array.from({ length: 24 }, (_, i) => {
                  const a = (i / 24) * Math.PI * 2 - Math.PI / 2;
                  const r1 = i % 6 === 0 ? 44 : 48;
                  return <line x1={60 + Math.cos(a) * r1} y1={60 + Math.sin(a) * r1} x2={60 + Math.cos(a) * 52} y2={60 + Math.sin(a) * 52} stroke="var(--fg-3)" stroke-width={i % 6 === 0 ? 2 : 1} />;
                })}
                <circle cx="60" cy="8" r="3" fill="var(--lamp)" />
                <circle cx={60 + Math.cos((8.75 / 24) * Math.PI * 2 - Math.PI / 2) * 52} cy={60 + Math.sin((8.75 / 24) * Math.PI * 2 - Math.PI / 2) * 52} r="3" fill="var(--lamp)" />
                <circle cx={60 + Math.cos((2 / 24) * Math.PI * 2 - Math.PI / 2) * 52} cy={60 + Math.sin((2 / 24) * Math.PI * 2 - Math.PI / 2) * 52} r="3" fill="var(--lamp)" />
                <line class="dial-hand" data-dial-hand x1="60" y1="60" x2="60" y2="18" stroke="var(--fg)" stroke-width="2" stroke-linecap="round" />
                <circle cx="60" cy="60" r="3" fill="var(--fg)" />
              </svg>
              <span class="caption">24 h · ticks are jobs · the hand is your time</span>
            </div>
          </div>
          <p class="caption">Jobs are created in the dashboard or CLI on every harness. Creating them by asking in chat is kiro-cli-only today — <a href="/verified/">status</a>.</p>
        </section>

        <section class="step" data-step="3" aria-labelledby="s3">
          <ClockHead time="02:30" title="Some things it is not allowed to do." id="s3" />
          <p class="step-body">The agent runs <code>cat ~/.aws/credentials</code>. It is refused before any human is asked, because <code>~/.aws</code> is on the deny list Warding's own gate enforces. The audit line lands in a hash-chained log.</p>
          <div class="refusal">
            <div class="stamp-seal stamp"><Ban class="lucide" aria-hidden="true" /> Refused · keystone · 02:30:41</div>
            <pre class="terminal sel-line"><code>deny path=~/.aws/credentials rule=sensitive_path sel=… sha256:9f2c…</code></pre>
            <pre class="terminal rule-block"><code><span class="dim"># security._SENSITIVE_HOME_DIRS (excerpt)</span>
".aws", ".ssh", ".gnupg", ".gpg", ".config/gcloud", ".azure",
".docker/config.json", ".kube/config", ".npmrc", ".pypirc",
".netrc", ".git-credentials"</code></pre>
          </div>
          <p class="caption">Enforced at Warding's own gate and in the OS sandbox. What is and isn't covered: <a href="/security/#scope">/security#scope</a>.</p>
        </section>

        <section class="step" data-step="4" aria-labelledby="s4">
          <ClockHead time="03:05" title="It asks first." id="s4" />
          <p class="step-body">It needs <code>git push</code>. The message reaches your phone with two buttons. Tap one.</p>
          <ApproveFromChatDemo client:visible />
          <ul class="channel-strip" aria-label="Chat channels and how approvals arrive">
            {channels.map((c) => (
              <li class="channel-tile">
                <span class="channel-name">{c.name}</span>
                {c.approval === "buttons" && <StatusChip kind="approved" label="Buttons" />}
                {c.approval === "typed" && <StatusChip kind="typed" label="Typed reply" />}
                {c.approval === "chat-only" && <StatusChip kind="info" label="Chat only" />}
                {c.approval === "chat-only" && <a class="caption" href="#channel-buttons">Buttons for this app: join the list</a>}
              </li>
            ))}
          </ul>
          <p class="caption">{channelCounts.buttons === 5 ? "Five" : channelCounts.buttons} apps with buttons. One typed. Four chat-only. We never say ten.</p>
          <div id="channel-buttons" class="channel-waitlist">
            <WaitlistForm client:visible list="channel-buttons" label="Tell me when in-chat approvals reach iMessage, WeChat, WeCom or Feishu" compact />
          </div>
        </section>

        <section class="step step-dawn" data-step="5" aria-labelledby="s5">
          <ClockHead time="07:00" title="What ran, what asked, what was refused." id="s5" />
          {site.shipped.morningReport ? (
            <p class="step-body">Posted to your channel and to the dashboard. The refusals are counted from the audit log, not guessed.</p>
          ) : (
            <>
              <p class="step-body">The morning report is <StatusChip kind="coming" label="in development" />. Until it ships, here is the real schedule calendar from the dashboard — no recorded night yet.</p>
              <Plate num="II" title="The week's schedule" caption="Dashboard · Schedule calendar · 2026-09-26 · no agent connected" note="No recorded night yet: the dots are seeded jobs, not runs." src={calendarShot} alt="The dashboard's schedule calendar: a week grid with jobs marked at 02:00, 03:00, 08:00, 09:00, 15:00 and 21:00 each day." crop={0.125} cropTop={0.16} />
            </>
          )}
        </section>
      </div>
    </div>
  </div>

  <div class="dawn" aria-hidden="true"></div>

  <div class="paper">
    <!-- 7. Bring the agent -->
    <section class="section wrap" id="harness" aria-labelledby="h7">
      <WardBars align="left" />
      <div class="two-col">
        <div class="reveal">
          <h2 id="h7">Bring the agent you already use.</h2>
          <p class="step-body">
            Warding launches the official <code>claude</code> (via the ACP project's <code>claude-agent-acp</code> adapter, fetched with <code>npx</code> on first run), <code>codex</code>, <code>goose</code>, <code>cursor</code>, <code>kimi</code>, <code>grok</code>, <code>pi</code>, <code>droid</code> or <code>kiro-cli</code> under your own login. One harness at a time, chosen in one setting; your schedules, memory and channels stay when you switch. Warding adds no run cap, and Warding Labs never sees your tokens or keys: there is no server of ours in the loop. Your vendor's plan limits and terms for unattended use apply exactly as in the terminal; for shared or production automation, use an API key.
          </p>
          <p class="caption">No Gemini, no OpenCode yet. <a href="/registry/">Registry</a>.</p>
        </div>
        <figure class="plate reveal" data-shot>
          <pre class="terminal planes"><code><span class="prompt">$ </span>{site.cli} planes
{planesLines.map((l, i) => (i === 0 ? <span class="amber">{l}{"\n"}</span> : <span>{l}{"\n"}</span>))}</code></pre>
          <figcaption><span class="plate-num">Plate III.</span> <code>{site.cli} planes</code> — CLI · 2026-09-26 · claude docked · one harness selected · the role line is omitted</figcaption>
        </figure>
      </div>
      <div class="matrix-wrap reveal">
        <table class="matrix">
          <caption class="caption">Compatibility, as verified. A check appears only where a dated row exists on <a href="/verified/">/verified</a>.</caption>
          <thead>
            <tr><th scope="col">Harness</th>{CAPABILITIES.map((c) => <th scope="col">{c.label}</th>)}</tr>
          </thead>
          <tbody>
            {harnesses.map((h) => (
              <tr>
                <th scope="row"><span class="mono">{h.command}</span> <span class="caption">{h.name.toLowerCase() !== h.command ? h.name : ""}{h.optional ? " · optional" : ""}</span></th>
                {CAPABILITIES.map((c) => {
                  const date = h.verified[c.key];
                  return date ? (
                    <td><a href={`/verified/#${h.id}-${c.key}`} class="status status-approved"><Check class="lucide" aria-hidden="true" /> {date}</a></td>
                  ) : (
                    <td class="unv">registered · unverified{h.upstreamMature ? " · upstream's mature path" : ""}</td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 8. The charter -->
    <section class="section wrap" id="charter" aria-labelledby="h8">
      <WardBars />
      <h2 id="h8" class="center">The rules it can't open.</h2>
      <p class="lead center measure mx">Four articles. Each one names the mechanism that holds it.</p>
      <CharterSheet foil class="charter">
        <article class="spread">
          <div class="spread-text reveal">
            <h3><span class="art">Article 1.</span> The agent cannot read or write its own policy.</h3>
            <p>The policy, its profiles and the admission and computer-use files live on paths that are on the deny list at Warding's own gate and inside the OS sandbox. Not "is not allowed to". Cannot.</p>
          </div>
          <div class="spread-proof">
            <ul class="keystone-list">{keystone.map((k) => <li>{k}</li>)}</ul>
            <div class="margin-drollery"><Drollery client:visible kind="bounce" /></div>
          </div>
        </article>
        <article class="spread">
          <div class="spread-text reveal">
            <h3><span class="art">Article 2.</span> Secrets are redacted before they reach the log.</h3>
            <p>Credential shapes are replaced at one chokepoint before anything is written. It is always on; there is no policy key to turn it off.</p>
          </div>
          <div class="spread-proof">
            <pre class="terminal"><code><span class="dim"># tool output, as the agent saw it</span>
aws_access_key_id = <span class="redact">{exampleKey}</span>
<span class="dim"># as the log received it</span>
aws_access_key_id = <span class="amber">[REDACTED: credential]</span></code></pre>
            <div class="margin-drollery"><Drollery client:visible kind="sleep" /></div>
          </div>
        </article>
        <article class="spread">
          <div class="spread-text reveal">
            <h3><span class="art">Article 3.</span> Tool decisions are appended to a hash-chained audit log you can verify.</h3>
            <p>Every decision at the gate is an entry whose hash covers the one before it. Edit one line and the chain breaks at that line.</p>
            <p class="caption"><code>{site.cli} audit verify</code> {site.shipped.auditVerify ? "" : <StatusChip kind="coming" label="[COMING]" />}</p>
          </div>
          <div class="spread-proof">
            <ol class="chain" reversed>
              {selEntries.map((e) => (
                <li class="chain-entry">
                  <span class="mono chain-hash"><Link2 class="lucide" aria-hidden="true" /> {e.hash}</span>
                  <span class="mono">{e.type} · {e.op}</span>
                  <span class="mono caption">{e.res}</span>
                  <span class="mono caption">prev {e.prev}</span>
                </li>
              ))}
            </ol>
            <div class="margin-drollery"><Drollery client:visible kind="envelope" /></div>
          </div>
        </article>
        <article class="spread">
          <div class="spread-text reveal">
            <h3><span class="art">Article 4.</span> Anything not granted by both the policy and the profile is denied.</h3>
            <p>Tightest wins. Enforced at Warding's own gate, even when the agent's config granted the tool.</p>
          </div>
          <div class="spread-proof venn-wrap">
            <svg class="venn" viewBox="0 0 320 180" role="img" aria-label="Two overlapping circles, POLICY and PROFILE; the overlap is the effective set">
              <defs>
                <clipPath id="clipA"><circle cx="120" cy="90" r="70" /></clipPath>
              </defs>
              <circle cx="120" cy="90" r="70" fill="none" stroke="var(--fg)" stroke-width="1.5" />
              <circle cx="200" cy="90" r="70" fill="var(--marker)" clip-path="url(#clipA)" />
              <circle cx="200" cy="90" r="70" fill="none" stroke="var(--fg)" stroke-width="1.5" />
              <text x="78" y="40" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--fg)">POLICY</text>
              <text x="214" y="40" font-size="12" font-family="IBM Plex Mono, monospace" fill="var(--fg)">PROFILE</text>
              <text x="132" y="95" font-size="11" font-family="IBM Plex Mono, monospace" fill="var(--fg)">effective</text>
            </svg>
            <pre class="terminal"><code>effective = POLICY ∩ PROFILE
<span class="dim"># denied unless BOTH grant it; adding a scope is data, never an evaluator edit</span></code></pre>
          </div>
        </article>
        <footer class="charter-foot">
          <p class="caption">Unaudited by a third party. The gate is fail-closed for denied paths and commands and fail-open for pre-authorised tools; the sandbox is fail-closed where no backend exists unless you opt in. Read the scope: <a href="/security/">/security</a>.</p>
          <LinkButton href="/security/">Read the charter</LinkButton>
        </footer>
      </CharterSheet>
      <Plate num="IV" title="The posture page" caption="Dashboard · Settings Security · 2026-09-26 · no agent connected" src={securityShot} alt="The dashboard's Security settings page listing the live posture: process sandbox, tool approval, sensitive path blocking, write-protected paths, denied commands, output redaction and credential patterns." crop={0.5} cropTop={0.48} class="posture-plate" sizes="(min-width: 1200px) 960px, 92vw" />
    </section>

    <!-- 9. Bento -->
    <section class="section wrap" id="desk" aria-labelledby="h9">
      <WardBars />
      <h2 id="h9" class="center">Everything else on the desk.</h2>
      <div class="bento">
        {bento.map((b) => (
          <a class="tile bento-tile reveal" href={b.href} rel="noopener" data-demo={b.demo}>
            <div class="demo" aria-hidden="true">
              {b.demo === "ledger" && <ul class="demo-ledger"><li>plan</li><li>execute</li><li>validate</li><li class="on">checkpoint 3</li></ul>}
              {b.demo === "fanout" && <div class="demo-fanout"><span></span><i></i><i></i><i></i></div>}
              {b.demo === "lesson" && <div class="demo-lesson"><span class="strike">use retries here</span><span class="mark">lesson: retry the flaky auth test once, then fail loud</span></div>}
              {b.demo === "apps" && <div class="demo-apps"><span>Code Review Sage</span><span>Issue Radar</span><span>PPTX Maker</span><span>Papyrus</span></div>}
              {b.demo === "themes" && <div class="demo-themes"><i style="background:#F3EEE3"></i><i style="background:#0B0E14"></i><i style="background:#2E3440"></i><i style="background:#1A1814"></i><i style="background:#FFB547"></i><i style="background:#B3301A"></i></div>}
              {b.demo === "langs" && <div class="demo-langs"><span>Schedule</span><span lang="zh-CN">计划</span><span lang="ja">スケジュール</span><span lang="ko">일정</span><span lang="de">Zeitplan</span></div>}
            </div>
            <h3>{b.title}</h3>
            <p class="caption">{b.body}</p>
            <span class="caption tile-link">Docs <ArrowRight class="lucide" aria-hidden="true" /></span>
          </a>
        ))}
      </div>
    </section>

    <!-- 10. What we don't claim -->
    <section class="section wrap" id="dont-claim" aria-labelledby="h10">
      <CharterSheet foil class="signed">
        <div class="signed-head">
          <h2 id="h10">What we don't claim.</h2>
          <WardSeal size={64} class="stamp" />
        </div>
        <ul class="signed-list">
          <li>One harness at a time, set globally. No second harness running alongside it.</li>
          <li>The model catalog lists names; it forwards nothing and holds no keys.</li>
          <li>Approve buttons on five chat apps; WhatsApp is typed; four apps are chat-only.</li>
          <li>Cron and subagents <em>from chat</em>, and the agent's mid-turn questions, work on kiro-cli today; on other harnesses create jobs and spawn subagents from the dashboard or CLI, and the agent cannot ask you a question mid-turn.</li>
          <li>The OS sandbox fails closed — it refuses to run rather than run unconfined — on Windows, in containers without user namespaces, and on Ubuntu ≥ 23.10 until <code>sudo {site.cli} sandbox install</code>; you can opt in to unsandboxed execution with a loud warning.</li>
          <li>Unaudited by a third party. Single owner. No hosted service. No signed installers yet.</li>
          <li>Your vendor's terms and any future metering of unattended use apply and may change.</li>
          <li>The default build contacts no server of ours; the embedding model is still fetched from a third-party CDN on first embedding use. The <code>lsof</code> run: <a href="/verified/">/verified</a>.</li>
        </ul>
        <p class="caption">How to report a bypass: <a href={site.links.securityMd} rel="noopener">SECURITY.md</a>.</p>
        <p class="signature">— laqaer, 2026-09-26</p>
      </CharterSheet>
    </section>

