<script>
  import { track } from "../lib/analytics";

  // The visitor's clock: the eyebrow and the 24-hour dial.
  const fmt = () => {
    try { return new Intl.DateTimeFormat(undefined, { hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date()); }
    catch { const d = new Date(); return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`; }
  };
  const eyebrow = document.querySelector<HTMLElement>("[data-local-time]");
  const hand = document.querySelector<SVGElement>("[data-dial-hand]");
  const tick = () => {
    if (eyebrow) eyebrow.textContent = fmt();
    if (hand) { const d = new Date(); hand.style.transform = `rotate(${((d.getHours() + d.getMinutes() / 60) / 24) * 360}deg)`; }
  };
  tick();
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) window.setInterval(tick, 30000);

  // The night narrative: the step whose section contains the 45% line of the
  // viewport drives the sticky world. A geometry pick on a throttled scroll
  // listener is deterministic where an observer band is not (two sections can
  // straddle the band, and the later one would win until it left).
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const steps = Array.from(document.querySelectorAll<HTMLElement>(".step[data-step]"));
  let current = -1;
  const setStep = (step: number) => {
    if (step === current) return;
    current = step;
    stage?.setAttribute("data-step", String(step));
    window.dispatchEvent(new CustomEvent("warding:step", { detail: { step } }));
  };
  const pick = () => {
    const line = window.innerHeight * 0.45;
    let cur = 0;
    for (const s of steps) {
      const r = s.getBoundingClientRect();
      if (r.top <= line && r.bottom > 0) cur = Number(s.dataset.step);
    }
    setStep(cur);
  };
  let raf = 0;
  const onScroll = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; pick(); }); };
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  pick();

  // Final band: copy the quickstart.
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-quickstart]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  copyBtn?.addEventListener("click", async () => {
    const text = copyBtn.dataset.copyQuickstart ?? "";
    try { await navigator.clipboard.writeText(text); if (status) status.textContent = "Copied"; }
    catch { if (status) status.textContent = "Select the quickstart at the top of the page to copy it."; }
    track("install_copy", { tab: "final" });
    window.setTimeout(() => { if (status) status.textContent = ""; }, 1800);
  });
  document.querySelectorAll<HTMLElement>("[data-track]").forEach((el) => {
    const ev = el.dataset.track;
    if (ev === "supporter_click" || ev === "setup_click" || ev === "pilot_call_click") el.addEventListener("click", () => track(ev));
  });
</script>
