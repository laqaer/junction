---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import StatusChip from "../../components/StatusChip.astro";
import { APPROVAL_LABEL } from "../../data/channels";

export async function getStaticPaths() {
  const entries = (await getCollection("channels")).filter((e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const kind = entry.data.approval === "buttons" ? "approved" : entry.data.approval === "typed" ? "typed" : "info";
---
<PageLayout title={entry.data.title} description={entry.data.description} h1={entry.data.h1} register={entry.data.ogRegister} ogSlug={`channels-${entry.id}`} breadcrumbs={[{ label: "Channels", href: "/channels/" }, { label: entry.data.h1, href: `/channels/${entry.id}/` }]}>
  <p><StatusChip kind={kind} label={`Approvals: ${APPROVAL_LABEL[entry.data.approval]}`} /></p>
  <article class="prose"><Content /></article>
</PageLayout>
<style>
  .prose { max-width: 72ch; display: grid; gap: 16px; margin-top: 16px; }
  .prose :global(h2) { margin-top: 24px; }
  .prose :global(pre) { padding: 14px 16px; background: var(--raised); }
</style>
